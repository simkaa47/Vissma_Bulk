<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"			
			 xmlns:conv="using:View.Converters"	
			 xmlns:mat="using:Material.Icons.Avalonia"
			 RequestedThemeVariant="Dark"
             x:Class="View.App">
	
    <Application.Styles>
		<FluentTheme/>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="/Resourses/Styles/Validation/ValidationErrors.xaml"/>
		<StyleInclude Source="/Resourses/Styles/GroupboxStyle.axaml"/>
		<StyleInclude Source="/Resourses/Styles/Windows.axaml"/>
		<mat:MaterialIconStyles />
	</Application.Styles>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Resourses/GlobalConverters.axaml"/>
				<ResourceInclude Source="/Resourses/CommonEnums.axaml"/>
				<ResourceInclude Source="/Resourses/Templates/ImagePathsDictionary.axaml"/>
				
			</ResourceDictionary.MergedDictionaries>
			
		</ResourceDictionary>
	</Application.Resources>
	
</Application>