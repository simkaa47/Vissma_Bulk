<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:View.UserControls.Events"
			 xmlns:vm="using:View.ViewModels"
			 x:DataType="vm:EventViewModel"
             x:Class="View.UserControls.Events.MainEventControl">
	<TabControl TabStripPlacement="Bottom">
		<TabItem Header="Текушие ошибки">
			<local:CurrentEventsUserControl/>
		</TabItem>
		<TabItem Header="История событий">
			<local:EventsHistoryControl/>
		</TabItem>
	</TabControl>
</UserControl>
