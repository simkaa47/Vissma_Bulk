<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=netstandard"
			 xmlns:sys="clr-namespace:System;assembly=netstandard"
			 xmlns:local="using:View.UserControls.HighBar"
			 xmlns:material="using:Material.Icons.Avalonia"
             x:Class="View.UserControls.HighBar.ConnectIndicatorControl">
	<UserControl.Resources>
		<scg:List x:TypeArguments="sys:Object" x:Key="ErrorColors">
			<SolidColorBrush Color="Red"/>
			<SolidColorBrush Color="LightGreen"/>
		</scg:List>
	</UserControl.Resources>
	<DockPanel  VerticalAlignment="Center" Margin="10,0,10,0">
		<material:MaterialIcon Kind="Connection" Height="40" Width="40" Margin="5"
							   Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:ConnectIndicatorControl} Path=State, 
							   Mode=OneWay,
							   Converter={StaticResource IfTrueConverter}, ConverterParameter={StaticResource ErrorColors}}"/>
		<TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=local:ConnectIndicatorControl} Path=Description}"
				   TextWrapping="Wrap" VerticalAlignment="Center">
			
		</TextBlock>
	</DockPanel>
</UserControl>
