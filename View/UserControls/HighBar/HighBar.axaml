<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Core.ViewModels"
			 xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:local="using:View.UserControls.HighBar"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="83"
			 x:DataType="vm:MainViewModel"
             x:Class="View.UserControls.HighBar.HighBar">
	<Canvas Width="1024" Height="83">
		<!--Кнопка Logout-->
		<Button Canvas.Top="0" Canvas.Left="932" Width="92" Height="83"
				Click="LogoutClick" Background="Transparent"/>
		<!--Кнопка Reset-->
		<Button Canvas.Top="8" Canvas.Left="625" Width="121" Height="69"
				CommandParameter="{Binding PlcViewModel.PlcMainService.PlcModel.ButtonCommandsModel.RstCmd}"
				Command="{Binding PlcViewModel.WriteParameterCommand}"
				Background="Transparent"/>
		
	</Canvas>
	
</UserControl>
