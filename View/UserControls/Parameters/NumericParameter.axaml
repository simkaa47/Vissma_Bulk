<local:ParameterCommon xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:View.UserControls.Parameters"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:CompileBindings="False"
             x:Class="View.UserControls.Parameters.NumericParameter">
	<DockPanel>
		<TextBlock Text="{Binding Description}"
				   TextWrapping="WrapWithOverflow"
				   VerticalAlignment="Center"
				   IsVisible="{Binding RelativeSource={RelativeSource AncestorType=local:ParameterCommon}, Path=!DescriptionInvisible}"/>
		<StackPanel Margin="20,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
			<TextBox Name="Input" Width="{Binding RelativeSource={RelativeSource AncestorType=local:ParameterCommon}, Path=ParamWidth, TargetNullValue=40}"
					 Background="Transparent"
					 MinWidth="20"
					 BorderThickness="1"
					 CornerRadius="4"
					 IsReadOnly="{Binding IsOnlyRead}"					 
					Text="{Binding WriteValue}">
				<TextBox.KeyBindings>
					<KeyBinding Gesture="Enter"
								Command="{Binding RelativeSource={RelativeSource AncestorType=local:ParameterCommon}, Path=Command}"
								CommandParameter="{Binding}">

					</KeyBinding>
				</TextBox.KeyBindings>
			</TextBox>
			<material:MaterialIcon Kind="DownloadCircle" Height="30" Width="30"
								   HorizontalAlignment="Center" VerticalAlignment="Center"
								   Foreground="White"
								   Margin="5,0,0,0" IsVisible="{Binding IsWriting}"/>
		</StackPanel>	
		
		
	</DockPanel>
</local:ParameterCommon>
