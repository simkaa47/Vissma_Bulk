<par:ParameterCommon xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:par="using:View.UserControls.Parameters"
			 xmlns:material="using:Material.Icons.Avalonia"
			 x:CompileBindings="False"
             x:Class="View.UserControls.Parameters.BoolIndicator">
	<DockPanel VerticalAlignment="Center">
		
		<StackPanel Margin="10,0,10,0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
			<Image Source="/Assets/106.png"
				   Height="30"
				   IsVisible="{Binding WriteValue}"
				   Width="30"/>
			<Image Source="/Assets/108.png"
				   Height="30"
				   IsVisible="{Binding !WriteValue}"
				   Width="30"/>

			<TextBlock Text="{Binding Description}"
				   VerticalAlignment="Center"
					   TextWrapping="Wrap"
				       IsVisible="{Binding RelativeSource={RelativeSource AncestorType=par:ParameterCommon} ,
				       Path=!DescriptionInvisible}"
					   Margin="10, 0"
				   TextTrimming="CharacterEllipsis"/>
		</StackPanel>


	</DockPanel>
</par:ParameterCommon>
