<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"			
			 x:DataType="vm:MainViewModel"			 
			 xmlns:vm="clr-namespace:Core.ViewModels;assembly=Core"
			 xmlns:acc="using:View.UserControls.Access"			 
			 xmlns:plc="using:View.UserControls.Plc"
             x:Class="View.UserControls.Settings.SettingsCommonControl">
	<TabControl TabStripPlacement="Left">		
		<TabItem Header="Управление пользователями">
			<acc:AccessControl DataContext="{Binding AccessViewModel}"/>
		</TabItem>		
		<TabItem Header="ПЛК">
			<plc:PlcConnectSettings DataContext="{Binding PlcViewModel}"/>
		</TabItem>		
	</TabControl>
</UserControl>
