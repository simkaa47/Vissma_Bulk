<par:ParameterCommon xmlns="https://github.com/avaloniaui"
					 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					 xmlns:par="using:View.UserControls.Parameters"
					 xmlns:plc="using:View.UserControls.Plc"
					 xmlns:stat="using:View.UserControls.Plc.Statuses"
					 x:CompileBindings="False"
					 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
					 x:Class="View.UserControls.Plc.Statuses.ProbotborStatus">
	<HeaderedContentControl Background="Black"
							Header="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=StatusName}">
		<Grid  ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="*,*">
			<plc:StatusTextIndicator Margin="10"
									 Grid.RowSpan="2"
									 Index="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=Index}"
									 Statuses="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=Statuses}"/>
			<par:BoolIndicator Grid.Column="1" Grid.Row="0"
								DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=SqHomeAbortParameter}"/>
			<par:BoolIndicator Grid.Column="2" Grid.Row="0"
							   DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=SqHomeParameter}"/>
			<par:BoolIndicator Grid.Column="3" Grid.Row="0"
							   DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=ReadyParameter}"/>
			<par:BoolIndicator Grid.Column="1" Grid.Row="1"
							   DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=SqWorkAbortParameter}"/>
			<par:BoolIndicator Grid.Column="2" Grid.Row="1"
							   DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=SqWorkParameter}"/>
			<par:BoolIndicator Grid.Column="3" Grid.Row="1"
							   DataContext="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=BusyParameter}"/>
			<Button Grid.Column="4" Grid.RowSpan="2" Margin="10"
					Command="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=Command}"
					IsVisible="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=ReadyParameter.Value}"
					CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=OtborCmdParameter}">
				<TextBlock Text="Отбор"/>
			</Button>
			<Button Grid.Column="4" Grid.RowSpan="2" Margin="10"
					Command="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=Command}"
					IsVisible="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=Index, Converter={StaticResource IfEqualConverter}, ConverterParameter=3}"
					CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=stat:ProbotborStatus}, Path=ReturnCmdParameter}">
				<TextBlock Text="Возврат ковша" TextWrapping="Wrap"/>
			</Button>
			
		</Grid>
	</HeaderedContentControl>
</par:ParameterCommon>
