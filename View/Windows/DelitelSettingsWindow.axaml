<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
		Width="768" Height="512"
		Background="#2C2C2C"
		xmlns:vm="using:Core.ViewModels"
		xmlns:plc="using:Core.Models.Plc"
		xmlns:par="using:View.UserControls.Parameters"
		xmlns:hb="using:View.UserControls.HighBar"
		x:Name="root"
		x:DataType="vm:MainViewModel"
        x:Class="View.Windows.DelitelSettingsWindow"
        Title="DelitelSettingsWindow">
	<Grid ColumnDefinitions="Auto, *"
		  RowDefinitions="Auto, Auto">
		<Grid Height="183" Width="275" HorizontalAlignment="Left" 
			  Grid.Row="0"
				DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Indication}"
			  x:DataType="plc:PlcIndicationModel">
			<Image Source="{Binding ProbotborStatus2.Value, Converter={StaticResource GetBitmapFromStringByIndexConverter}, ConverterParameter={StaticResource DelitelImageStatuses}}"
			    Height="183" Width="275"/>
			<Image Source="/Assets/119.jpg" Margin="5"
				   VerticalAlignment="Top" Height="30" Width="30"
				   HorizontalAlignment="Left"/>
		</Grid>
		<StackPanel Orientation="Vertical" Grid.Row="1" Margin="10">
			<!--Кнопка Отбор-->
			<Button Height="70" Width="238" 
					Background="Transparent"
					Command="{Binding PlcViewModel.WriteParameterCommand}"
					CommandParameter="{Binding PlcViewModel.PlcMainService.PlcModel.ButtonCommandsModel.OtborCmd2}">
				<Button.Content>
						<StackPanel Orientation="Horizontal">
							<Image Source="/Assets/107.jpg" Width="32" Height="32"/>
							<TextBlock Text="ПРОВЕСТИ СОКРАЩЕНИЕ" Margin="5" VerticalAlignment="Center"/>
						</StackPanel>
					</Button.Content>
			</Button>
			<!--Кнопка Возврат-->
			<Grid  Height="70" Width="238" Canvas.Top="100" Canvas.Left="270"
				   IsVisible="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.ProbotborStatus2.Value, Converter={StaticResource IfEqualConverter}, ConverterParameter=3}">
				<Image Source="/Assets/115.jpg"/>
				<Button Background="Transparent"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Command="{Binding PlcViewModel.WriteParameterCommand}"
						CommandParameter="{Binding PlcViewModel.PlcMainService.PlcModel.ButtonCommandsModel.ReturnCmd2}">

				</Button>
			</Grid>
		</StackPanel>
		<StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="10">
			<!--Статус делителя-->
			<TextBlock Margin="5"
				Foreground="White" FontSize="18"
					   Text="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.ProbotborStatus2.Value, 
					   Converter={StaticResource GetByIndexFromParameterConverter}, 
					   ConverterParameter={StaticResource ProbotborStatus}}"/>
			<!--Скорость ПЧ делителя-->
			<par:NumericParameter Margin="5"
								  ParamWidth="50"
							  Command="{Binding #root.DataContext.PlcViewModel.WriteParameterCommand, Mode=TwoWay}"
							  DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Settings.FcFrequencesSvs[1]}"
							  DescriptionInvisible="False"/>
			<!--Время работы делителя -->
			<par:NumericParameter Margin="5"
								  ParamWidth="50"
							  Command="{Binding #root.DataContext.PlcViewModel.WriteParameterCommand, Mode=TwoWay}"
							  DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Settings.DelitelWorkTime}"
							  DescriptionInvisible="False"/>
			<!--Время работы-->
			<DockPanel Margin="5" HorizontalAlignment="Stretch">
				<TextBlock Text="Время работы, с" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
					<TextBlock Text="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.DelitelTimeCurrent.Value}" Foreground="White"
					   DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="5, 0"/>
			</DockPanel>

			<!--Индикаторы-->
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbHomeAbort2}"
							   DescriptionInvisible="False"
							   Margin="0, 5"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbHome2}"
							   DescriptionInvisible="False"
							   Margin="0, 5"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbWork2}"
							   DescriptionInvisible="False"
							   Margin="0, 5"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbWorkAbort2}"
							   DescriptionInvisible="False"
							   Margin="0, 5"/>
		</StackPanel>
		<Viewbox IsVisible="False">
		<Canvas Width="1024" Height="600">
			<Canvas.Background>
				<ImageBrush Source="/Assets/11.png"/>
			</Canvas.Background>
			<hb:HighBar/>
			<!--Кнопка Отбор-->
			<Button Height="70" Width="238" Canvas.Top="100" Canvas.Left="10"
					Background="Transparent"
					Command="{Binding PlcViewModel.WriteParameterCommand}"
					CommandParameter="{Binding PlcViewModel.PlcMainService.PlcModel.ButtonCommandsModel.OtborCmd2}"/>
			<!--Кнопка Возврат-->
			<Grid  Height="70" Width="238" Canvas.Top="100" Canvas.Left="270"
				   IsVisible="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.ProbotborStatus2.Value, Converter={StaticResource IfEqualConverter}, ConverterParameter=3}">
				<Image Source="/Assets/115.jpg"/>
				<Button Background="Transparent"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Command="{Binding PlcViewModel.WriteParameterCommand}"
						CommandParameter="{Binding PlcViewModel.PlcMainService.PlcModel.ButtonCommandsModel.ReturnCmd2}">

				</Button>
			</Grid>
			<!--Индикатор делителя-->
			<Image Source="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.ProbotborStatus2.Value, Converter={StaticResource GetBitmapFromStringByIndexConverter} ,ConverterParameter={StaticResource DelitelImageStatuses}}"
					    Height="183" Width="275" Canvas.Top="230" Canvas.Left="120"/>
			<!--Статус делителя-->
			<TextBlock Canvas.Left="550" Canvas.Top="200"
				Foreground="White" FontSize="18"
					   Text="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.ProbotborStatus2.Value, 
					   Converter={StaticResource GetByIndexFromParameterConverter}, 
					   ConverterParameter={StaticResource ProbotborStatus}}"/>
			<!--Скорость ПЧ делителя-->
			<par:NumericParameter Canvas.Top="239" Canvas.Left="700"
								  ParamWidth="50"
							  Command="{Binding #root.DataContext.PlcViewModel.WriteParameterCommand, Mode=TwoWay}"
							  DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Settings.FcFrequencesSvs[1]}"
							  DescriptionInvisible="True"/>
			<!--Время работы делителя -->
			<par:NumericParameter Canvas.Top="272" Canvas.Left="700"
								  ParamWidth="50"
							  Command="{Binding #root.DataContext.PlcViewModel.WriteParameterCommand, Mode=TwoWay}"
							  DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Settings.DelitelWorkTime}"
							  DescriptionInvisible="True"/>
			<TextBlock Text="{Binding PlcViewModel.PlcMainService.PlcModel.Indication.DelitelTimeCurrent.Value}" Foreground="White"
					   Canvas.Top="312" Canvas.Left="730"/>
			<!--Индикаторы-->
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbHomeAbort2}"
							   DescriptionInvisible="True"
							   Canvas.Top="376" Canvas.Left="555"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbHome2}"
							   DescriptionInvisible="True"
							   Canvas.Top="418" Canvas.Left="555"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbWork2}"
							   DescriptionInvisible="True"
							   Canvas.Top="458" Canvas.Left="555"/>
			<par:BoolIndicator DataContext="{Binding PlcViewModel.PlcMainService.PlcModel.Di.SqProbWorkAbort2}"
							   DescriptionInvisible="True"
							   Canvas.Top="498" Canvas.Left="555"/>
			<!--Панель навигации-->
			<Button Canvas.Bottom="0" Canvas.Left="0"
					Height="42"
					Background="Transparent"
					Click="OpenControlWindow"
					Width="342"/>
			<Button Canvas.Bottom="0" Canvas.Left="684"
					Height="42"
					Background="Transparent"
					Click="OpenErrorsWindow"
					Width="342"/>
		</Canvas>
	</Viewbox>
	</Grid>
</Window>
