<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
		Width="768" Height="1024"
		xmlns:vm="using:Core.ViewModels"
		xmlns:plc="using:Core.Models.Plc"
		xmlns:par="using:View.UserControls.Parameters"
		xmlns:dry="using:View.UserControls.Equipment.DrySettings"
		xmlns:hb="using:View.UserControls.HighBar"
		x:CompileBindings="False"
		x:DataType="vm:MainViewModel"        
        x:Class="View.Windows.DrySettingsWindow"
        Title="DrySettingsWindow">
	<dry:DrySettingsControl Margin="5"/>	
</Window>
